<% if @books.empty? %>
  <p class="text-slate-500 text-center py-12">No books found.</p>
<% else %>
  <div class="flex items-center justify-between mb-3">
    <p class="text-slate-500 text-sm"><%= @books.count %> result<%= @books.count == 1 ? '' : 's' %></p>
    <button @click="compact = !compact"
            class="text-slate-500 hover:text-slate-300 transition"
            :title="compact ? 'Card view' : 'Compact view'">
      <template x-if="compact">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/>
        </svg>
      </template>
      <template x-if="!compact">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </template>
    </button>
  </div>

  <!-- Card view -->
  <div x-show="!compact" class="space-y-2">
    <% @books.each do |book| %>
      <div class="bg-slate-800 hover:bg-slate-750 border border-slate-700 hover:border-indigo-500 rounded-xl px-5 py-4 cursor-pointer transition group"
           @click="modalKey = '<%= h(book[:key]) %>'; modalOpen = true">
        <div class="flex items-start justify-between gap-4">
          <div class="min-w-0">
            <h3 class="font-semibold text-slate-100 group-hover:text-indigo-300 transition leading-snug">
              <%= h(book[:title]) %>
            </h3>
            <p class="text-slate-400 text-sm mt-0.5"><%= h(book[:author]) %></p>
          </div>
          <div class="flex flex-col items-end gap-1 shrink-0 text-sm">
            <span class="<%= star_color(book[:stars]) %> font-medium"><%= format_stars(book[:stars]) %></span>
            <% if book[:vector_score] %>
              <span class="text-slate-400 text-xs">relevance <%= (book[:vector_score] * 100).round %></span>
            <% end %>
          </div>
        </div>
        <div class="flex items-center justify-between gap-3 mt-2 text-xs text-slate-500">
          <div class="flex gap-3">
            <span><%= h(book[:key]) %></span>
            <% if book[:year] && book[:year] > 0 %>
              <span>·</span>
              <span><%= book[:year] %></span>
            <% end %>
            <% if book[:ratings] && book[:ratings] > 0 %>
              <span>·</span>
              <span><%= book[:ratings].to_s.reverse.gsub(/(\d{3})(?=\d)/, '\\1,').reverse %> ratings</span>
            <% end %>
          </div>
          <% if book[:categories]&.any? %>
            <div class="flex flex-wrap gap-1 justify-end">
              <% book[:categories].each do |cat| %>
                <span class="bg-slate-700 text-slate-400 rounded px-1.5 py-0.5 leading-none"><%= h(cat.split.map(&:capitalize).join(' ')) %></span>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Compact view -->
  <div x-show="compact" class="divide-y divide-slate-800">
    <% @books.each do |book| %>
      <div class="flex items-center gap-3 py-1.5 px-1 hover:bg-slate-800 rounded cursor-pointer group text-sm"
           @click="modalKey = '<%= h(book[:key]) %>'; modalOpen = true">
        <span class="font-mono text-slate-600 text-xs w-20 shrink-0"><%= h(book[:key]) %></span>
        <span class="text-slate-100 group-hover:text-indigo-300 transition truncate min-w-0 flex-1 font-medium"><%= h(book[:title]) %></span>
        <span class="text-slate-500 truncate w-56 shrink-0 hidden sm:block">
          <%= h(book[:author]) %><% if book[:year] && book[:year] > 0 %> · <%= book[:year] %><% end %>
        </span>
        <span class="<%= star_color(book[:stars]) %> shrink-0 w-16 text-right"><%= book[:stars] ? format('%.1f ⭐', book[:stars]) : '—' %></span>
      </div>
    <% end %>
  </div>
<% end %>
